{
  "name": "airbnb-automation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 tests/browser/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "setup:owner": "node --env-file=.env --import tsx scripts/create-owner.ts",
    "reset:password": "node --env-file=.env --import tsx scripts/reset-password.ts",
    "events:replay": "node --env-file=.env --import tsx scripts/replay-events.ts",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "check:env": "node --env-file=.env --import tsx scripts/check-env.ts",
    "db:mark-environment": "node --env-file-if-exists=.env --import tsx scripts/mark-environment.ts",
    "db:prelaunch-check": "node --env-file-if-exists=.env --import tsx scripts/prelaunch-check.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "fixtures:anonymize": "node --import tsx scripts/anonymize-feed.ts",
    "calendar:mode": "node --env-file-if-exists=.env --import tsx scripts/calendar-mode.ts",
    "calendar:shadow-report": "node --env-file-if-exists=.env --import tsx scripts/shadow-report.ts",
    "erasures:export": "node --env-file-if-exists=.env --import tsx scripts/erasures.ts export",
    "erasures:reapply": "node --env-file-if-exists=.env --import tsx scripts/erasures.ts reapply",
    "format": "prettier --write src scripts tests docs ops .github README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md package.json next.config.ts eslint.config.mjs tsconfig.json vercel.json",
    "format:check": "prettier --check src scripts tests docs ops .github README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md package.json next.config.ts eslint.config.mjs tsconfig.json vercel.json",
    "package": "python3 scripts/package.py",
    "audit:deps": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "^10.0.0",
    "ical.js": "^2.2.1",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "twilio": "^5.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "fast-check": "^4.10.2",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.8",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
