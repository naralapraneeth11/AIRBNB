# Copy this file to .env and replace every REPLACE_ value.
# Never commit .env. Never put these values in variables starting with NEXT_PUBLIC_.

# ---------- Database (Supabase Postgres) ----------
# Runtime connection used by the live app. Transaction pooler (port 6543),
# limited role airbnb_app, with ?pgbouncer=true on the end.
DATABASE_URL="postgresql://airbnb_app.REPLACE_PROJECT_REF:REPLACE_APP_PASSWORD@REPLACE_POOLER_HOST:6543/postgres?pgbouncer=true"

# Used by migrations, setup:owner, reset:password and check:env.
# LOCALLY, for migrations + setup:owner: the owner (postgres.REF) Session pooler string, port 5432.
# On VERCEL and for check:env: the airbnb_app Session pooler string, port 5432.
DIRECT_URL="postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_DB_PASSWORD@REPLACE_POOLER_HOST:5432/postgres"

# ---------- App ----------
# Local: http://localhost:3000   Vercel: your exact https://....vercel.app address
APP_URL="http://localhost:3000"

# ---------- Secrets (generate each one separately, never reuse) ----------
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_64_HEX_CHARS"
CRON_SECRET="REPLACE_64_HEX_CHARS"
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS={"v1":"REPLACE_BASE64_32_BYTE_KEY"}
ENCRYPTION_KEY_ID="v1"

# ---------- Photo storage (Supabase Storage, PRIVATE bucket) ----------
SUPABASE_URL="https://REPLACE_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_SERVICE_ROLE_KEY"
STORAGE_BUCKET="airbnb-private"

# ---------- Calendar imports ----------
# Comma-separated exact hostnames from your iCal export links.
ICAL_ALLOWED_HOSTS="www.airbnb.com,www.vrbo.com"
# Optional tuning
# SYNC_POLL_SECONDS=120
# SYNC_STALE_MINUTES=240

# ---------- One-time owner setup (DELETE these 4 lines after pnpm setup:owner) ----------
# BOOTSTRAP_EMAIL="you@example.com"
# BOOTSTRAP_PASSWORD="REPLACE_AT_LEAST_14_CHARS"
# BOOTSTRAP_NAME="Your Name"
# BOOTSTRAP_WORKSPACE="My Rentals"

# ---------- Optional providers (add later, only when you turn the feature on) ----------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# RESEND_API_KEY=""
# EMAIL_FROM=""
# OPENAI_API_KEY=""
# OPENAI_MODEL=""
# AI_TIMEOUT_MS=""
# MESSAGING_ALLOWED_HOSTS=""
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT=""
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
