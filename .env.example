# Copy this file to .env and replace every REPLACE_ value.
# Never commit .env. Never put these values in variables starting with NEXT_PUBLIC_.

# ---------- Environment (SEC 04) ----------
# production, staging, preview, development or test. The database must carry
# a matching marker (pnpm db:mark-environment <name> with the owner as
# DIRECT_URL); the app refuses to serve data otherwise. A staging database
# serves staging and preview deployments only; production serves production.
APP_ENVIRONMENT="development"

# ---------- Database (Supabase Postgres) ----------
# Runtime connection used by the live app. Transaction pooler (port 6543),
# limited role airbnb_app, with ?pgbouncer=true on the end.
DATABASE_URL="postgresql://airbnb_app.REPLACE_PROJECT_REF:REPLACE_APP_PASSWORD@REPLACE_POOLER_HOST:6543/postgres?pgbouncer=true"

# Used by migrations, setup:owner, reset:password, db:mark-environment,
# db:prelaunch-check and check:env.
# LOCALLY, for migrations + setup:owner: the owner (postgres.REF) Session pooler string, port 5432.
# On VERCEL and for check:env: the airbnb_app Session pooler string, port 5432.
DIRECT_URL="postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_DB_PASSWORD@REPLACE_POOLER_HOST:5432/postgres"

# Section 2: database connections per process, set explicitly. Defaults when
# unset: 1 per serverless function on Vercel, 3 for a local web server, and
# 4 for `pnpm worker`. Keep (function concurrency x pool size) within the
# database plan's connection limit.
# DATABASE_POOL_SIZE=1
# WORKER_DATABASE_POOL_SIZE=4

# ---------- App ----------
# Local: http://localhost:3000   Vercel: your exact https://....vercel.app address
APP_URL="http://localhost:3000"

# ---------- Secrets (generate each one separately, never reuse) ----------
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_64_HEX_CHARS"
CRON_SECRET="REPLACE_64_HEX_CHARS"
# Bearer token for GET /api/health/operations (heartbeat, work progress,
# backup freshness and environment checks for an external monitor).
MONITOR_SECRET="REPLACE_64_HEX_CHARS"
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS={"v1":"REPLACE_BASE64_32_BYTE_KEY"}
ENCRYPTION_KEY_ID="v1"

# ---------- Photo storage (Supabase Storage, PRIVATE bucket) ----------
SUPABASE_URL="https://REPLACE_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_SERVICE_ROLE_KEY"
STORAGE_BUCKET="airbnb-private"

# ---------- Calendar imports ----------
# Airbnb, Vrbo, Booking.com and Expedia feeds are checked against built-in
# domain rules. Optionally restrict Google and other calendars to these exact
# hostnames (comma-separated). Every feed gets the same network protections.
# ICAL_ALLOWED_HOSTS="calendar.google.com"
# Alert when a calendar has not been checked successfully for this long.
# SYNC_STALE_MINUTES=240
# FETCH 02: a contact (email or URL) shown on /fetcher, the page the calendar
# fetcher's user agent links to.
# FETCHER_CONTACT="calendar-fetcher@example.com"

# ---------- Operations alert thresholds (optional) ----------
# OPS_HEARTBEAT_MAX_MINUTES=5
# OPS_PROGRESS_MAX_MINUTES=15
# OPS_BACKLOG_MAX_LAG_MINUTES=30
# OPS_BACKUP_MAX_AGE_HOURS=26

# ---------- One-time owner setup (DELETE these 4 lines after pnpm setup:owner) ----------
# BOOTSTRAP_EMAIL="you@example.com"
# BOOTSTRAP_PASSWORD="REPLACE_AT_LEAST_14_CHARS"
# BOOTSTRAP_NAME="Your Name"
# BOOTSTRAP_WORKSPACE="My Rentals"

# ---------- Optional providers (add later, only when you turn the feature on) ----------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# RESEND_API_KEY=""
# EMAIL_FROM=""
# OPENAI_API_KEY=""
# OPENAI_MODEL=""
# AI_TIMEOUT_MS=""
# MESSAGING_ALLOWED_HOSTS=""
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT=""
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# ---------- Backup jobs only (never set these in the application) ----------
# See docs/OPERATIONS.md, "Backups". These belong to the backup job's own
# protected environment.
# BACKUP_DATABASE_URL="postgresql://hostsphere_backup:REPLACE@REPLACE_HOST:5432/postgres?sslmode=require"
# BACKUP_PUBLIC_KEY_FILE="backup-public.pem"
# BACKUP_VERIFY_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restore_check"
# ESCROW_ENCRYPTION_KEYS={"v1":"REPLACE_BASE64_32_BYTE_KEY"}
