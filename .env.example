# Database
DATABASE_URL="postgresql://user:password@host:5432/airbnb_automation?sslmode=require"

# Auth / security
AUTH_SECRET="replace-with-long-random-string"
ENCRYPTION_KEY="replace-with-32-byte-base64-or-hex-secret"

# App URL (production)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional: Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional: Web Push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional: Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Cron (protect /api/cron)
CRON_SECRET="replace-with-random-secret"
